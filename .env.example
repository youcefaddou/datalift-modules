# Copier ce fichier en .env et compléter. Ne jamais commiter .env.

# Environnement
DATALIFT_ENV=local

# Base de métadonnées
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datalift
POSTGRES_USER=datalift
POSTGRES_PASSWORD=change-me

# API simulées
MOCK_YOOZ_URL=http://localhost:4010
MOCK_IFS_URL=http://localhost:4011
MOCK_LUCCA_URL=http://localhost:4012
MOCK_PROGESSI_URL=http://localhost:4013

# Modèle IA (si utilisé côté modules)
LLM_PROVIDER=
LLM_API_KEY=
